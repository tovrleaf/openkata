package templates

templ Nav() {
	<nav class="nav">
		<img src="/static/img/icon.webp" alt="" class="nav-icon"/>
		<a href="/" class="nav-brand">OPENKATA.dev</a>
		<div class="nav-links">
			<a href="/skills/" class="nav-link">Skills</a>
			<a href="/rules/" class="nav-link">Rules</a>
			<a href="/profiles/" class="nav-link">Profiles</a>
		</div>
		<div class="nav-actions">
			<button id="search-open-btn" class="search-btn" aria-label="Search">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="currentColor" width="20" height="20"><path d="M27.414,24.586l-5.077-5.077C23.386,17.928,24,16.035,24,14c0-5.514-4.486-10-10-10S4,8.486,4,14s4.486,10,10,10c2.035,0,3.928-0.614,5.509-1.663l5.077,5.077c0.78,0.781,2.048,0.781,2.828,0C28.195,26.633,28.195,25.367,27.414,24.586z M7,14c0-3.86,3.14-7,7-7s7,3.14,7,7s-3.14,7-7,7S7,17.86,7,14z"/></svg>
			</button>
			<div class="theme-switcher">
				<button class="theme-switcher__btn" onclick="cycleTheme()" aria-label="Next theme"></button>
			</div>
		</div>
	</nav>
	<div id="search-overlay" class="search-overlay" hidden>
		<div class="search-overlay__backdrop"></div>
		<div class="search-overlay__panel">
			<div class="search-overlay__header">
				<input type="text" id="search-input" class="search-overlay__input" placeholder="Search..." autocomplete="off"/>
				<button id="search-close-btn" class="search-overlay__close" aria-label="Close search">&times;</button>
			</div>
			<div id="search-results" class="search-overlay__results"></div>
		</div>
	</div>
}
