package templates

import "fmt"

templ Skills(skills []SkillEntry) {
	@Layout("Skills") {
		<nav class="nav">
			<a href="/" class="nav-brand">OPENKATA.dev</a>
			<div class="theme-switcher">
				<button class="theme-switcher__btn" onclick="cycleTheme()" aria-label="Next theme"></button>
			</div>
		</nav>

		<main>
			<section class="hero hero--kanji">
				<span class="hero-kanji">技</span>
				<div class="hero-text">
					<h1 class="cursor">Skills</h1>
					<p class="comment">Portable, platform-agnostic practices for AI agents.</p>
				</div>
			</section>

			if len(skills) == 0 {
				<p>No skills available yet.</p>
			} else {
				<div class="skill-list">
					for i, s := range skills {
						<details class="skill-entry">
							<summary class="skill-summary">
								<div class="skill-summary-top">
									<span class="skill-number">{ fmt.Sprintf("%02d", i+1) }</span>
									<span class="skill-name">{ s.Name }</span>
									<span class="skill-summary-right">
										<span class="skill-downloads">{ fmt.Sprintf("%d", s.Downloads) } ↓</span>
										<span class="skill-sep">|</span>
										<span class="skill-version">v{ s.Version }</span>
										<span class="skill-toggle-icon"></span>
									</span>
								</div>
								<div class="skill-tags">
									if len(SplitTags(s.Tags)) > 0 {
										for _, tag := range SplitTags(s.Tags) {
											<span class={ TagClass(tag) }>{ tag }</span>
										}
									}
									<a class="btn-open" href={ templ.SafeURL(fmt.Sprintf("/skills/%s/", s.Name)) }>Open</a>
								</div>
							</summary>
							<div class="skill-body">
																if len(FirstSentence(s.Description)) > 200 {
									<p class="skill-description"><strong>{ FirstSentence(s.Description) }</strong></p>
								} else {
									<p class="skill-description"><strong>{ FirstSentence(s.Description) }</strong><br/>{ AfterFirstSentence(s.Description) }</p>
								}
							</div>
						</details>
					}
				</div>
			}
		</main>

		<footer class="footer">
			© 2026 OPENKATA.dev // License: <a href="https://github.com/tovrleaf/openkata/blob/main/LICENSE" target="_blank" rel="noopener">MIT</a>
		</footer>
	}
}
