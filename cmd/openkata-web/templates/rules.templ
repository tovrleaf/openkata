package templates

import "fmt"

templ Rules(rules []SkillEntry) {
	@Layout("Rules") {
		@Nav()

		<main>
			<section class="hero">
				<h1>Rules</h1>
				<p class="comment">Always-on constraints applied to every agent session.</p>
			</section>

			if len(rules) == 0 {
				<p>No rules available yet.</p>
			} else {
				<div class="artifact-list">
					for _, r := range rules {
						<article class="artifact-card">
							<h2>{ r.Name }</h2>
							<p class="artifact-description">{ r.Description }</p>
							<div class="artifact-meta">
								<span class="artifact-version">v{ r.Version }</span>
								if r.Downloads > 0 {
									<span class="artifact-downloads">{ fmt.Sprintf("%d", r.Downloads) } downloads</span>
								}
							</div>
						</article>
					}
				</div>
			}
		</main>

		<footer class="footer">
			© 2026 OPENKATA.dev // License: <a href="https://github.com/tovrleaf/openkata/blob/main/LICENSE" target="_blank" rel="noopener">MIT</a>
		</footer>
	}
}
