package templates

import (
	"fmt"
)

templ RuleDetailPage(rule ArtifactDetail) {
	@Layout(rule.Name) {
		@Nav()

		<main data-artifact-name={ rule.Name } data-artifact-version={ rule.Version } data-artifact-path="rules">
			<section class="detail-header">
				<div class="detail-title-row">
					<div class="hero--kanji">
						<a href="/rules/" class="hero-kanji">則</a>
						<div class="hero-text">
							<span class="hero-label">Rule</span>
							<h1>{ rule.Name }</h1>
						</div>
					</div>
					<div class="detail-title-right">
						<select class="version-select">
							for i, v := range rule.Versions {
								if v == rule.Version {
									if i == 0 {
										<option value={ v } selected>v{ v } (Latest)</option>
									} else {
										<option value={ v } selected>v{ v }</option>
									}
								} else {
									if i == 0 {
										<option value={ v }>v{ v } (Latest)</option>
									} else {
										<option value={ v }>v{ v }</option>
									}
								}
							}
						</select>
						<nav class="artifact-nav" aria-label="Rule navigation">
							if rule.Prev != "" {
								<a href={ templ.SafeURL(fmt.Sprintf("/rules/%s/", rule.Prev)) } class="artifact-nav-link" title={ rule.Prev }>←</a>
							} else {
								<span class="artifact-nav-link artifact-nav-link--disabled">←</span>
							}
							if rule.Next != "" {
								<a href={ templ.SafeURL(fmt.Sprintf("/rules/%s/", rule.Next)) } class="artifact-nav-link" title={ rule.Next }>→</a>
							} else {
								<span class="artifact-nav-link artifact-nav-link--disabled">→</span>
							}
						</nav>
					</div>
				</div>
				<p class="detail-meta">
					<span class="detail-downloads">{ fmt.Sprintf("%d", rule.Downloads) } ↓</span>
					<span class="artifact-sep">|</span>
					<a class="detail-download" href={ templ.SafeURL(fmt.Sprintf("/rules/%s/archive", rule.Name)) }>.tar.gz</a>
				</p>
				if len(SplitTags(rule.Tags)) > 0 {
					<div class="artifact-tags">
						for _, tag := range SplitTags(rule.Tags) {
							<span class={ TagClass(tag) }>{ tag }</span>
						}
					</div>
				}
			</section>

			if rule.Rationale != "" && rule.Acknowledgments != "" {
				@TabBar([]TabDef{{"overview", "Overview"}, {"files", "Files"}, {"rationale", "Rationale"}, {"changelog", "Changelog"}, {"acknowledgments", "Acknowledgments"}}, "Rule sections")
			} else if rule.Rationale != "" {
				@TabBar([]TabDef{{"overview", "Overview"}, {"files", "Files"}, {"rationale", "Rationale"}, {"changelog", "Changelog"}}, "Rule sections")
			} else if rule.Acknowledgments != "" {
				@TabBar([]TabDef{{"overview", "Overview"}, {"files", "Files"}, {"changelog", "Changelog"}, {"acknowledgments", "Acknowledgments"}}, "Rule sections")
			} else {
				@TabBar([]TabDef{{"overview", "Overview"}, {"files", "Files"}, {"changelog", "Changelog"}}, "Rule sections")
			}

			<section class="tab-panel active" id="panel-overview">
				if rule.Description != "" {
					<p class="detail-description">{ rule.Description }</p>
				}
				if rule.Docs != "" {
					<div class="detail-docs">
						@templ.Raw(rule.Docs)
					</div>
				} else {
					<p class="comment">No documentation available.</p>
				}
			</section>

			<section class="tab-panel" id="panel-files">
				@FileViewer(rule.Files, rule.FileContents, "rules", rule.Name, rule.Version)
			</section>

			if rule.Rationale != "" {
				<section class="tab-panel" id="panel-rationale">
					@templ.Raw(rule.Rationale)
				</section>
			}

			<section class="tab-panel" id="panel-changelog">
				if rule.Changelog != "" {
					@templ.Raw(rule.Changelog)
				} else {
					<p class="comment">No changelog available.</p>
				}
			</section>

			if rule.Acknowledgments != "" {
				<section class="tab-panel" id="panel-acknowledgments">
					@templ.Raw(rule.Acknowledgments)
				</section>
			}
		</main>

		<footer class="footer">
			© 2026 OPENKATA.dev // License: <a href="https://github.com/tovrleaf/openkata/blob/main/LICENSE" target="_blank" rel="noopener">MIT</a>
		</footer>
	}
}
