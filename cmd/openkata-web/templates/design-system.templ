package templates

templ DesignSystem() {
	@Layout("Style Guide") {
		<nav class="nav">
			<a href="/" class="nav-brand">OPENKATA.dev</a>
			<div class="nav-links">
				<a href="/skills/" class="nav-link">Skills</a>
			</div>
			<div class="theme-switcher">
				<button class="theme-switcher__btn" onclick="cycleTheme()" aria-label="Next theme"></button>
			</div>
		</nav>

		<main>
			<section>
				<h1 class="cursor">Design System Preview</h1>
				<p class="comment">All elements rendered with the current token palette</p>
			</section>

			<section>
				<h2>Typography</h2>
				<h1>Heading 1 — The Way of the Agent</h1>
				<h2>Heading 2 — Codified Practices</h2>
				<h3>Heading 3 — monospace style</h3>
				<p>
					Body text with <a href="#">a link</a> and <code>inline code</code>.
					The quick brown fox jumps over the lazy dog. Practices are portable,
					platform-agnostic, and work with any agent supporting the spec.
				</p>
				<p>
					Second paragraph to show spacing. Skills avoid coupling to specific
					tooling, MCP servers, or platform-specific features so they remain
					portable across environments.
				</p>
			</section>

			<section>
				<h2>Blockquote</h2>
				<blockquote>
					<p>Kata in this repo are platform-agnostic. They follow the Agent Skills
					specification and work with any agent that supports it.</p>
				</blockquote>
			</section>

			<section>
				<h2>Code Block</h2>
				<pre><code>cp -r skills/create-adr /path/to/your-project/.agents/skills/
make skills
make deploy</code></pre>
			</section>

			<section>
				<h2>Unordered List</h2>
				<ul>
					<li>Portable across environments</li>
					<li>No build step or infrastructure required</li>
					<li>Works with Kiro, Claude Code, OpenCode</li>
					<li>Single source of truth in SKILL.md</li>
				</ul>
			</section>

			<section>
				<h2>Ordered List</h2>
				<ol>
					<li>Specify requirements</li>
					<li>Design architecture</li>
					<li>Break into tasks</li>
					<li>Implement autonomously</li>
					<li>Validate in fresh session</li>
				</ol>
			</section>

			<section>
				<h2>Table</h2>
				<table>
					<thead>
						<tr>
							<th>Skill</th>
							<th>Version</th>
							<th>Status</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td><code>create-adr</code></td>
							<td>v1.1.0</td>
							<td>Released</td>
						</tr>
						<tr>
							<td><code>spec-driven-dev</code></td>
							<td>—</td>
							<td>Unreleased</td>
						</tr>
						<tr>
							<td><code>grill-me</code></td>
							<td>—</td>
							<td>Unreleased</td>
						</tr>
					</tbody>
				</table>
			</section>

			<section>
				<h2>Cards</h2>
				<div class="card-grid">
					<div class="card">
						<h3>create-adr</h3>
						<p>Detects architectural decisions in conversation and guides creation of ADRs.</p>
					</div>
					<div class="card">
						<h3>spec-driven-dev</h3>
						<p>Drives feature development through specify, design, tasks, implement, validate.</p>
					</div>
					<div class="card">
						<h3>commit-conventions</h3>
						<p>Enforces Conventional Commits format and branch naming conventions.</p>
					</div>
					<div class="card">
						<h3>grill-me</h3>
						<p>Challenges a plan, spec, or ADR by interviewing until all corners are covered.</p>
					</div>
				</div>
			</section>

			<section>
				<h2>Badges &amp; Tags</h2>
				<p>
					<span class="badge badge-red">breaking</span>
					<span class="badge badge-orange">warning</span>
					<span class="badge badge-yellow">pending</span>
					<span class="badge badge-green">released</span>
					<span class="badge badge-purple">experimental</span>
				</p>
			</section>

			<section>
				<h2>Horizontal Rule</h2>
				<p>Content above the divider.</p>
				<hr/>
				<p>Content below the divider.</p>
			</section>
		</main>

		<footer class="footer">
			© 2026 OPENKATA.dev // License: <a href="https://github.com/tovrleaf/openkata/blob/main/LICENSE" target="_blank" rel="noopener">MIT</a>
		</footer>
	}
}
