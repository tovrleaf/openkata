package templates

import (
	"fmt"
)

templ SkillDetailPage(skill ArtifactDetail) {
	@Layout(skill.Name) {
		@Nav()

		<main data-artifact-name={ skill.Name } data-artifact-version={ skill.Version } data-artifact-path="skills">
			<section class="detail-header">
				<div class="detail-title-row">
					<div class="hero--kanji">
						<a href="/skills/" class="hero-kanji">技</a>
						<div class="hero-text">
							<span class="hero-label">Skill</span>
							<h1>{ skill.Name }</h1>
						</div>
					</div>
					<div class="detail-title-right">
						<select class="version-select">
							for i, v := range skill.Versions {
								if v == skill.Version {
									if i == 0 {
										<option value={ v } selected>v{ v } (Latest)</option>
									} else {
										<option value={ v } selected>v{ v }</option>
									}
								} else {
									if i == 0 {
										<option value={ v }>v{ v } (Latest)</option>
									} else {
										<option value={ v }>v{ v }</option>
									}
								}
							}
						</select>
						<nav class="artifact-nav" aria-label="Skill navigation">
							if skill.Prev != "" {
								<a href={ templ.SafeURL(fmt.Sprintf("/skills/%s/", skill.Prev)) } class="artifact-nav-link" title={ skill.Prev }>←</a>
							} else {
								<span class="artifact-nav-link artifact-nav-link--disabled">←</span>
							}
							if skill.Next != "" {
								<a href={ templ.SafeURL(fmt.Sprintf("/skills/%s/", skill.Next)) } class="artifact-nav-link" title={ skill.Next }>→</a>
							} else {
								<span class="artifact-nav-link artifact-nav-link--disabled">→</span>
							}
						</nav>
					</div>
				</div>
				<p class="detail-meta">
					<span class="detail-downloads">{ fmt.Sprintf("%d", skill.Downloads) } ↓</span>
					<span class="artifact-sep">|</span>
					<a class="detail-download" href={ templ.SafeURL(fmt.Sprintf("/skills/%s/archive", skill.Name)) }>.tar.gz</a>
				</p>
				if len(SplitTags(skill.Tags)) > 0 {
					<div class="artifact-tags">
						for _, tag := range SplitTags(skill.Tags) {
							<a href={ templ.SafeURL(fmt.Sprintf("/catalog/?q=%s", tag)) } class={ TagClass(tag) }>{ tag }</a>
						}
					</div>
				}
			</section>

			@TabBar(SkillTabs(skill), "Skill sections")

			<section class="tab-panel active" id="panel-overview">
				if skill.Description != "" {
					<p class="detail-description">{ skill.Description }</p>
				}
				if skill.Docs != "" {
					<div class="detail-docs">
						@templ.Raw(skill.Docs)
					</div>
				} else {
					<p class="comment">No documentation available.</p>
				}
			</section>

			<section class="tab-panel" id="panel-files">
				@FileViewer(skill.Files, skill.FileContents, "skills", skill.Name, skill.Version)
			</section>

			if skill.Rationale != "" {
				<section class="tab-panel" id="panel-rationale">
					@templ.Raw(skill.Rationale)
				</section>
			}

			<section class="tab-panel" id="panel-changelog">
				if skill.Changelog != "" {
					@templ.Raw(skill.Changelog)
				} else {
					<p class="comment">No changelog available.</p>
				}
			</section>

			if len(skill.Models) > 0 || skill.TesslScore > 0 {
				<section class="tab-panel" id="panel-benchmarks">
					if skill.TesslScore > 0 {
						<div class="benchmark-tessl">
							<h3>Quality Score</h3>
							<p class="benchmark-score">{ fmt.Sprintf("%d", skill.TesslScore) }%</p>
							if skill.Published {
								<a href={ templ.SafeURL(fmt.Sprintf("https://tessl.io/skills/%s", skill.Name)) } target="_blank">View on Tessl Registry</a>
							}
						</div>
					}
					if len(skill.Models) > 0 {
						<div class="benchmark-effectiveness">
							<h3>Effectiveness</h3>
							<table class="benchmark-table">
								<thead><tr><th>Model</th><th>Effectiveness</th><th>Scenarios</th></tr></thead>
								<tbody>
									for _, m := range skill.Models {
										<tr>
											<td>{ m.Label }</td>
											<td>{ fmt.Sprintf("%d%%", m.Effectiveness) }</td>
											<td>{ fmt.Sprintf("%d/%d pass", CountPass(m.Scenarios), len(m.Scenarios)) }</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
						<div class="benchmark-scenarios">
							<h3>Scenarios</h3>
							for _, m := range skill.Models {
								<h4>{ m.Label }</h4>
								for _, s := range m.Scenarios {
									<div class="benchmark-scenario-row">
										if s.Pass {
											<span class="benchmark-pass">✓</span>
										} else {
											<span class="benchmark-fail">✗</span>
										}
										<span>{ s.Name }</span>
										<span class="comment">{ s.Description }</span>
									</div>
								}
							}
						</div>
					}
				</section>
			}

			if skill.Acknowledgments != "" {
				<section class="tab-panel" id="panel-acknowledgments">
					@templ.Raw(skill.Acknowledgments)
				</section>
			}

		</main>

		<footer class="footer">
			© 2026 OPENKATA.dev // License: <a href="https://github.com/tovrleaf/openkata/blob/main/LICENSE" target="_blank" rel="noopener">MIT</a>
		</footer>
	}
}
