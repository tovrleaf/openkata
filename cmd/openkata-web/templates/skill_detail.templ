package templates

import (
	"fmt"
	"strings"
)

templ SkillDetailPage(skill SkillDetail) {
	@Layout(skill.Name) {
		@Nav()

		<main data-artifact-name={ skill.Name } data-artifact-version={ skill.Version } data-artifact-path="skills">
			<section class="detail-header">
				<div class="detail-title-row">
					<div class="hero--kanji">
						<span class="hero-kanji">技</span>
						<div class="hero-text">
							<span class="hero-label">Skill</span>
							<h1>{ skill.Name }</h1>
						</div>
					</div>
					if len(skill.Versions) > 1 {
						<select class="version-select">
							for i, v := range skill.Versions {
								if v == skill.Version {
									if i == 0 {
										<option value={ v } selected>v{ v } (Latest)</option>
									} else {
										<option value={ v } selected>v{ v }</option>
									}
								} else {
									if i == 0 {
										<option value={ v }>v{ v } (Latest)</option>
									} else {
										<option value={ v }>v{ v }</option>
									}
								}
							}
						</select>
					} else {
						<span class="detail-version">v{ skill.Version }</span>
					}
				</div>
				<p class="detail-meta">
					<span class="detail-downloads">{ fmt.Sprintf("%d", skill.Downloads) } ↓</span>
					<span class="artifact-sep">|</span>
					<a class="detail-download" href={ templ.SafeURL(fmt.Sprintf("/skills/%s/archive", skill.Name)) }>.tar.gz</a>
				</p>
				if len(SplitTags(skill.Tags)) > 0 {
					<div class="artifact-tags">
						for _, tag := range SplitTags(skill.Tags) {
							<span class={ TagClass(tag) }>{ tag }</span>
						}
					</div>
				}
			</section>

			<nav class="tabs" aria-label="Skill sections">
				<button class="tab active" data-tab="overview">Overview</button>
				<button class="tab" data-tab="files">Files</button>
				<button class="tab" data-tab="changelog">Changelog</button>
				if skill.Acknowledgments != "" {
					<button class="tab" data-tab="acknowledgments">Acknowledgments</button>
				}
			</nav>

			<section class="tab-panel active" id="panel-overview">
				if skill.Description != "" {
					<p class="detail-description">{ skill.Description }</p>
				}
				if skill.Docs != "" {
					<div class="detail-docs">
						@templ.Raw(skill.Docs)
					</div>
				} else {
					<p class="comment">No documentation available.</p>
				}
			</section>

			<section class="tab-panel" id="panel-files">
				if len(skill.Files) > 0 {
					<div class="file-tree" id="file-tree">
						@templ.Raw(buildFileTree(skill.Files, skill.Name, skill.Version))
					</div>
					<div class="file-blocks">
						for _, f := range skill.Files {
							<details class="file-block" id={ "file-" + fileID(f) }>
								<summary class="file-block-header">
									<span class="file-block-name">{ f }</span>
									<span class="file-block-modes">
										if strings.HasSuffix(f, ".md") {
											if _, ok := skill.FileContents["__rendered__"+f]; ok {
												<button class="file-mode-btn" data-view="preview" data-file={ f }>Preview</button>
												<span class="file-mode-sep">|</span>
												<button class="file-mode-btn" data-view="code" data-file={ f }>Code</button>
												<span class="file-mode-sep">|</span>
											}
										}
										<a class="file-mode-btn" href={ templ.SafeURL(fmt.Sprintf("/skills/%s/%s/raw/%s", skill.Name, skill.Version, f)) } target="_blank" rel="noopener" onclick="event.stopPropagation()">Raw</a>
									</span>
								</summary>
								<div class="file-block-content">
									<div class="file-block-body" data-file={ f }>
										if strings.HasSuffix(f, ".md") {
											if rendered, ok := skill.FileContents["__rendered__"+f]; ok {
												<div class="file-preview" data-file={ f }>@templ.Raw(rendered)</div>
												<pre class="file-code" data-file={ f } style="display:none"><code>{ skill.FileContents[f] }</code></pre>
											} else {
												<pre class="file-code" data-file={ f }><code>{ skill.FileContents[f] }</code></pre>
											}
										} else {
											<pre class="file-code" data-file={ f }><code>{ skill.FileContents[f] }</code></pre>
										}
									</div>
								</div>
							</details>
						}
					</div>
				} else {
					<p class="comment">No files available.</p>
				}
			</section>

			<section class="tab-panel" id="panel-changelog">
				if skill.Changelog != "" {
					@templ.Raw(skill.Changelog)
				} else {
					<p class="comment">No changelog available.</p>
				}
			</section>

			if skill.Acknowledgments != "" {
				<section class="tab-panel" id="panel-acknowledgments">
					@templ.Raw(skill.Acknowledgments)
				</section>
			}

		</main>

		<footer class="footer">
			© 2026 OPENKATA.dev // License: <a href="https://github.com/tovrleaf/openkata/blob/main/LICENSE" target="_blank" rel="noopener">MIT</a>
		</footer>
	}
}
