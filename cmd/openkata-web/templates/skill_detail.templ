package templates

import "fmt"

templ SkillDetailPage(skill SkillDetail) {
	@Layout(skill.Name) {
		<nav class="nav">
			<a href="/" class="nav-brand">OPENKATA.dev</a>
			<div class="nav-links">
				<a href="/skills/" class="nav-link">Skills</a>
			</div>
			<div class="theme-switcher">
				<button class="theme-switcher__btn" onclick="cycleTheme()" aria-label="Next theme"></button>
			</div>
		</nav>

		<main>
			<section class="detail-header">
				<div class="detail-title-row">
					<div class="hero--kanji">
						<span class="hero-kanji">技</span>
						<div class="hero-text">
							<h1>{ skill.Name }</h1>
						</div>
					</div>
					if len(skill.Versions) > 1 {
						<select class="version-select" data-skill={ skill.Name }>
							for _, v := range skill.Versions {
								if v == skill.Version {
									<option value={ v } selected>v{ v }</option>
								} else {
									<option value={ v }>v{ v }</option>
								}
							}
						</select>
					} else {
						<span class="detail-version">v{ skill.Version }</span>
					}
				</div>
				<p class="detail-meta">
					<span class="detail-downloads">{ fmt.Sprintf("%d", skill.Downloads) } ↓</span>
					<span class="skill-sep">|</span>
					<a class="detail-download" href={ templ.SafeURL(fmt.Sprintf("/skills/%s/archive", skill.Name)) }>.tar.gz</a>
				</p>
				if len(SplitTags(skill.Tags)) > 0 {
					<div class="skill-tags">
						for _, tag := range SplitTags(skill.Tags) {
							<span class={ TagClass(tag) }>{ tag }</span>
						}
					</div>
				}
			</section>

			<nav class="tabs" aria-label="Skill sections">
				<button class="tab active" data-tab="overview">Overview</button>
				<button class="tab" data-tab="files">Files</button>
				<button class="tab" data-tab="changelog">Changelog</button>
				if skill.Acknowledgments != "" {
					<button class="tab" data-tab="acknowledgments">Acknowledgments</button>
				}
			</nav>

			<section class="tab-panel active" id="panel-overview">
				if skill.Description != "" {
					<p class="detail-description">{ skill.Description }</p>
				}
				if skill.Docs != "" {
					<div class="detail-docs">
						@templ.Raw(skill.Docs)
					</div>
				} else {
					<p class="comment">No documentation available.</p>
				}
			</section>

			<section class="tab-panel" id="panel-files">
				if len(skill.Files) > 0 {
					<div class="file-tree" id="file-tree">
						@templ.Raw(buildFileTree(skill.Files, skill.Name, skill.Version))
					</div>
					<div class="file-viewer" id="file-viewer" style="display:none">
						<div class="file-viewer-header">
							<span class="file-viewer-name" id="file-viewer-name"></span>
							<div class="file-viewer-actions">
								<button class="tab active" data-view="preview" id="btn-preview">Preview</button>
								<button class="tab" data-view="code" id="btn-code">Code</button>
								<a class="tab" id="btn-raw" href="#" target="_blank" rel="noopener">Raw</a>
							</div>
						</div>
						<div class="file-viewer-content" id="file-viewer-content"></div>
					</div>
				} else {
					<p class="comment">No files available.</p>
				}
			</section>

			<section class="tab-panel" id="panel-changelog">
				if skill.Changelog != "" {
					@templ.Raw(skill.Changelog)
				} else {
					<p class="comment">No changelog available.</p>
				}
			</section>

			if skill.Acknowledgments != "" {
				<section class="tab-panel" id="panel-acknowledgments">
					@templ.Raw(skill.Acknowledgments)
				</section>
			}

			<script>
				(function() {
					// Version select navigation
					var versionSelect = document.querySelector('.version-select');
					if (versionSelect) {
						versionSelect.addEventListener('change', function() {
							window.location.href = '/skills/' + this.dataset.skill + '/' + this.value;
						});
					}

					// Tab switching
					document.querySelectorAll('.tabs .tab').forEach(function(btn) {
						btn.addEventListener('click', function() {
							switchTab(btn.dataset.tab);
						});
					});

					function switchTab(name) {
						document.querySelectorAll('.tabs .tab').forEach(function(b) { b.classList.remove('active'); });
						document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
						var activeBtn = document.querySelector('.tabs .tab[data-tab="'+name+'"]');
						if (activeBtn) activeBtn.classList.add('active');
						var panel = document.getElementById('panel-' + name);
						if (panel) panel.classList.add('active');
					}

					// Overview link interception — relative links switch to Files tab
					var overview = document.getElementById('panel-overview');
					if (overview) {
						overview.addEventListener('click', function(e) {
							var link = e.target.closest('a');
							if (!link) return;
							var href = link.getAttribute('href');
							if (!href || href.startsWith('http') || href.startsWith('#')) return;
							e.preventDefault();
							switchTab('files');
							highlightFile(href);
						});
					}

					// File tree click handling
					var fileTree = document.getElementById('file-tree');
					if (fileTree) {
						fileTree.addEventListener('click', function(e) {
							var item = e.target.closest('[data-file]');
							if (!item) return;
							e.preventDefault();
							showFile(item.dataset.file);
						});
					}

					// File viewer view toggle
					var btnPreview = document.getElementById('btn-preview');
					var btnCode = document.getElementById('btn-code');
					if (btnPreview) btnPreview.addEventListener('click', function() { setView('preview'); });
					if (btnCode) btnCode.addEventListener('click', function() { setView('code'); });

					var fileContents = {};
					var currentFile = '';
					var currentView = 'preview';

					// Embed file contents from server
					var fc = document.getElementById('file-contents-data');
					if (fc) {
						try { fileContents = JSON.parse(fc.textContent); } catch(e) {}
					}

					function showFile(path) {
						currentFile = path;
						var viewer = document.getElementById('file-viewer');
						var nameEl = document.getElementById('file-viewer-name');
						var rawBtn = document.getElementById('btn-raw');
						viewer.style.display = 'block';
						nameEl.textContent = path;
						rawBtn.href = '/skills/' + document.body.dataset.skillName + '/' + document.body.dataset.skillVersion + '/raw/' + path;
						// Default view: markdown → preview, else → code
						if (path.endsWith('.md')) {
							setView('preview');
						} else {
							setView('code');
						}
					}

					function setView(view) {
						currentView = view;
						document.querySelectorAll('.file-viewer-actions .tab').forEach(function(b) { b.classList.remove('active'); });
						var btn = document.querySelector('.file-viewer-actions [data-view="'+view+'"]');
						if (btn) btn.classList.add('active');
						renderContent();
					}

					function renderContent() {
						var content = fileContents[currentFile] || '';
						var el = document.getElementById('file-viewer-content');
						if (currentView === 'code' || (currentView === 'preview' && !currentFile.endsWith('.md'))) {
							el.innerHTML = '<pre><code>' + escapeHtml(content) + '</code></pre>';
						} else {
							// Preview for .md — use pre-rendered HTML if available
							var rendered = fileContents['__rendered__' + currentFile];
							if (rendered) {
								el.innerHTML = rendered;
							} else {
								el.innerHTML = '<pre><code>' + escapeHtml(content) + '</code></pre>';
							}
						}
					}

					function escapeHtml(s) {
						var d = document.createElement('div');
						d.textContent = s;
						return d.innerHTML;
					}

					function highlightFile(path) {
						// Normalize path
						path = path.replace(/^\.\//, '');
						var item = document.querySelector('[data-file="'+path+'"]');
						if (item) {
							item.classList.add('file-highlight');
							setTimeout(function() { item.classList.remove('file-highlight'); }, 2000);
							showFile(path);
						}
					}
				})();
			</script>
			<script type="application/json" id="file-contents-data">
				@templ.Raw(fileContentsJSON(skill.FileContents))
			</script>
			<script>
				document.body.dataset.skillName = { skill.Name };
				document.body.dataset.skillVersion = { skill.Version };
			</script>
		</main>

		<footer class="footer">
			© 2026 OPENKATA.dev // License: <a href="https://github.com/tovrleaf/openkata/blob/main/LICENSE" target="_blank" rel="noopener">MIT</a>
		</footer>
	}
}
