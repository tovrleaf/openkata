package templates

templ Home() {
	@Layout("Home") {
		<nav class="nav">
			<a href="/" class="nav-brand">OPENKATA.dev</a>
			<div class="nav-links">
				<a href="/skills/" class="nav-link">Skills</a>
			</div>
			<div class="theme-switcher">
				<button class="theme-switcher__btn" onclick="cycleTheme()" aria-label="Next theme"></button>
			</div>
		</nav>

		<main>
			<section class="hero hero--kanji">
				<span class="hero-kanji">型</span>
				<div class="hero-text">
					<h1 class="cursor">OpenKata</h1>
					<p class="comment">Codified practices for AI agents — teach your agents the way.</p>
				</div>
			</section>

			<div class="logo-section">
				<img src="/static/img/logo.webp" alt="OpenKata logo" class="site-logo site-logo--light"/>
				<img src="/static/img/logo-dark.webp" alt="OpenKata logo" class="site-logo site-logo--dark"/>
			</div>

			<h2>About</h2>
			<p>
				What was implicit craft must become codified practice.
				Open Kata turns engineering knowledge into portable,
				reusable workflows that AI agents can follow — so good
				patterns are shared, not lost.
			</p>
			<p>
				A collection of platform-agnostic skills and rules
				that work with any agent supporting the
				<a href="https://agentskills.io/" target="_blank" rel="noopener">Agent Skills specification</a>.
				No vendor lock-in. No build step. Just files.
			</p>

			<h2>Status</h2>
			<p>
				Early development. Skills and rules are being built
				and tested in real projects. Source code available at
				<a href="https://github.com/tovrleaf/openkata" target="_blank" rel="noopener">GitHub</a>.
			</p>
		</main>

		<footer class="footer">
			© 2026 OPENKATA.dev // License: <a href="https://github.com/tovrleaf/openkata/blob/main/LICENSE" target="_blank" rel="noopener">MIT</a>
		</footer>
	}
}
