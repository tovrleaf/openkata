package templates

import "fmt"

templ Profiles(profiles []SkillEntry) {
	@Layout("Profiles") {
		<nav class="nav">
			<a href="/" class="nav-brand">OPENKATA.dev</a>
			<div class="nav-links">
				<a href="/skills/" class="nav-link">Skills</a>
			</div>
			<div class="theme-switcher">
				<button class="theme-switcher__btn" onclick="cycleTheme()" aria-label="Next theme"></button>
			</div>
		</nav>

		<main>
			<section class="hero">
				<h1>Profiles</h1>
				<p class="comment">Agent role definitions with scoped permissions.</p>
			</section>

			if len(profiles) == 0 {
				<p>No profiles available yet.</p>
			} else {
				<div class="skill-list">
					for _, p := range profiles {
						<article class="skill-card">
							<h2>{ p.Name }</h2>
							<p class="skill-description">{ p.Description }</p>
							<div class="skill-meta">
								<span class="skill-version">v{ p.Version }</span>
								if p.Downloads > 0 {
									<span class="skill-downloads">{ fmt.Sprintf("%d", p.Downloads) } downloads</span>
								}
							</div>
						</article>
					}
				</div>
			}
		</main>

		<footer class="footer">
			© 2026 OPENKATA.dev // License: <a href="https://github.com/tovrleaf/openkata/blob/main/LICENSE" target="_blank" rel="noopener">MIT</a>
		</footer>
	}
}
