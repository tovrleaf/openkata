package templates

import "fmt"

templ Profiles(profiles []SkillEntry) {
	@Layout("Profiles") {
		@Nav()

		<main>
			<section class="hero">
				<h1>Profiles</h1>
				<p class="comment">Agent role definitions with scoped permissions.</p>
			</section>

			if len(profiles) == 0 {
				<p>No profiles available yet.</p>
			} else {
				<div class="artifact-list">
					for _, p := range profiles {
						<article class="artifact-card">
							<h2>{ p.Name }</h2>
							<p class="artifact-description">{ p.Description }</p>
							<div class="artifact-meta">
								<span class="artifact-version">v{ p.Version }</span>
								if p.Downloads > 0 {
									<span class="artifact-downloads">{ fmt.Sprintf("%d", p.Downloads) } downloads</span>
								}
							</div>
						</article>
					}
				</div>
			}
		</main>

		<footer class="footer">
			© 2026 OPENKATA.dev // License: <a href="https://github.com/tovrleaf/openkata/blob/main/LICENSE" target="_blank" rel="noopener">MIT</a>
		</footer>
	}
}
