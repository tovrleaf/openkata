{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ReadArtifacts",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::openkata-artifacts",
        "arn:aws:s3:::openkata-artifacts/*"
      ]
    },
    {
      "Sid": "DynamoDBAccess",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:UpdateItem", "dynamodb:Scan", "dynamodb:PutItem"],
      "Resource": [
        "arn:aws:dynamodb:eu-north-1:152406482128:table/openkata-downloads",
        "arn:aws:dynamodb:eu-north-1:152406482128:table/openkata-download-events"
      ]
    }
  ]
}
